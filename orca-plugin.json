{
  "manifestVersion": 2,
  "id": "git-history",
  "name": "Git History",
  "version": "0.1.1",
  "description": "Git history in an editor tab: commits, changed files and side-by-side diffs for your workspace or one file.",
  "author": {
    "name": "moseoh",
    "url": "https://github.com/moseoh"
  },
  "repository": "https://github.com/moseoh/orca-git-history",
  "icon": "assets/icon.png",
  "engines": {
    "orca": ">=1.4.248"
  },
  "execution": "trusted-worker",
  "pluginApi": 1,
  "main": "src/worker.ts",
  "contributes": {
    "customEditors": [
      {
        "id": "git-history",
        "title": "Git History",
        "extensions": [
          ".githistory"
        ],
        "entry": "editor/main.ts",
        "frame": "isolated"
      }
    ],
    "newFiles": [
      {
        "id": "git-history",
        "title": "Git History",
        "extension": ".githistory"
      }
    ]
  },
  "capabilities": [
    {
      "kind": "workspace:read"
    },
    {
      "kind": "workspace:write"
    },
    {
      "kind": "storage:own"
    }
  ]
}
